# PostgreSQL（两组都要保留，账号密码必须一致）
# - POSTGRES_*：compose 里的数据库容器用来初始化账号（仅首次建库时生效），
#   compose 里的 app 也用它们拼出连接串
# - DATABASE_URL：本地直接运行 app（uv run uvicorn）和 alembic 迁移时读取
# 改密码时：先在库里执行 ALTER USER ... PASSWORD，再同时改下面两处，最后重启 app
POSTGRES_USER=resume_app
POSTGRES_PASSWORD=replace_with_a_random_password
POSTGRES_DB=resume_assistant
DATABASE_URL=postgresql+psycopg://resume_app:replace_with_a_random_password@127.0.0.1:5432/resume_assistant

# 登录功能接入前的服务端操作人标识；客户端请求不能覆盖
DEFAULT_HR_ID=hr_admin

# 模型网关：全仓库唯一一组地址 + 密钥（任意 OpenAI 兼容网关），app/parser/knowledge 共用。
# 网关需同时提供下方用到的对话、视觉（OCR）、embedding、rerank 模型。
LLM_API_KEY=replace_with_your_api_key
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 主服务模型任务
NORMALIZATION_MODEL=qwen-plus
NORMALIZATION_TIMEOUT_SECONDS=20
AGENT_MODEL=qwen-plus
AGENT_TIMEOUT_SECONDS=30

# 解析服务（PDF -> 文本，独立微服务；本地起在 8002）
# compose 内为 http://parser:8002
PARSER_SERVICE_BASE_URL=http://127.0.0.1:8002

# 知识库服务（Wiki 卡片切片、向量化与检索；compose 内为 http://knowledge:8001）
KNOWLEDGE_SERVICE_BASE_URL=http://127.0.0.1:8001

# PDF 解析服务
OCR_MODEL=qwen-vl-max
MAX_UPLOAD_SIZE_MB=5
MIN_EFFECTIVE_CHARS=50
OCR_MAX_RETRIES=2
OCR_TIMEOUT_SECONDS=30

# 知识库服务
EMBEDDING_MODEL=qwen3-embedding-8b
RERANK_MODEL=qwen3-reranker-8b
KNOWLEDGE_DATA_DIR=./data
KNOWLEDGE_WIKI_DIR=./data/wiki
KNOWLEDGE_CHUNK_SIZE=550
KNOWLEDGE_CHUNK_OVERLAP=80
KNOWLEDGE_ROUGH_TOP_K=15
KNOWLEDGE_FINAL_TOP_K=5
KNOWLEDGE_REFUSAL_THRESHOLD=0.35
EMBEDDING_TIMEOUT_SECONDS=120
RERANK_TIMEOUT_SECONDS=120

AUTH_SESSION_HOURS=8

# 知识图谱服务（services/graph；Neo4j 默认端口 7687，浏览器管理界面 7474）
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace_with_a_random_password
GRAPH_SERVICE_BASE_URL=http://127.0.0.1:8003
# 图谱三元组抽取所用的对话模型：无默认值，必须显式配置（调用抽取时才检查，未配置会直接报错）
# 密钥与网关地址沿用上面全仓库共用的 LLM_API_KEY / LLM_BASE_URL
GRAPH_LLM_MODEL=qwen3.7-plus
GRAPH_LLM_TIMEOUT_SECONDS=60
GRAPH_EXTRACT_MAX_RETRIES=1
