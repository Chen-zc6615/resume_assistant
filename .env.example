# PostgreSQL
POSTGRES_USER=resume_app
POSTGRES_PASSWORD=replace_with_a_random_password
POSTGRES_DB=resume_assistant
DATABASE_URL=postgresql+psycopg://resume_app:replace_with_a_random_password@127.0.0.1:5432/resume_assistant

# 登录功能接入前的服务端操作人标识；客户端请求不能覆盖
DEFAULT_HR_ID=hr_admin

# Large language model
DASHSCOPE_API_KEY=replace_with_your_api_key
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus

# 解析服务（PDF -> 文本，独立微服务；本地起在 8002）
# compose 内为 http://parser:8002
PARSER_SERVICE_BASE_URL=http://127.0.0.1:8002

# 知识库服务（Wiki 卡片切片、向量化与检索；compose 内为 http://knowledge:8001）
KNOWLEDGE_SERVICE_BASE_URL=http://127.0.0.1:8001

# 解析/知识库服务的模型配置（供 services/parser 与 services/knowledge）
# 解析服务与知识库复用主服务密钥；知识库端点需支持 embedding/rerank
MODEL_API_KEY=${DASHSCOPE_API_KEY}
MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# PDF 解析服务
OCR_MODEL=qwen-vl-max
MAX_UPLOAD_SIZE_MB=5
MIN_EFFECTIVE_CHARS=50
OCR_MAX_RETRIES=2
PARSE_TIMEOUT_SECONDS=30

# 知识库服务
EMBEDDING_MODEL=qwen3-embedding-8b
RERANK_MODEL=qwen3-reranker-8b
KNOWLEDGE_DATA_DIR=./data
KNOWLEDGE_WIKI_DIR=./data/wiki
KNOWLEDGE_CHUNK_SIZE=550
KNOWLEDGE_CHUNK_OVERLAP=80
KNOWLEDGE_ROUGH_TOP_K=15
KNOWLEDGE_FINAL_TOP_K=5
KNOWLEDGE_REFUSAL_THRESHOLD=0.35
MODEL_TIMEOUT_SECONDS=120


AUTH_SESSION_HOURS=8
