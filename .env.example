# PostgreSQL
POSTGRES_USER=resume_app
POSTGRES_PASSWORD=replace_with_a_random_password
POSTGRES_DB=resume_assistant
DATABASE_URL=postgresql+psycopg://resume_app:replace_with_a_random_password@127.0.0.1:5432/resume_assistant

# Large language model
DASHSCOPE_API_KEY=replace_with_your_api_key

# 解析服务（PDF -> 文本，独立微服务；本地起在 8002）
# compose 内为 http://parser:8002
PARSER_SERVICE_BASE_URL=http://127.0.0.1:8002
